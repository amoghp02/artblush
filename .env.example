# PostgreSQL (Neon) connection string — https://neon.tech
# Used by server actions, route handlers, and the seed script.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Razorpay — https://dashboard.razorpay.com
# key_id is public (used on the client for the checkout modal).
# key_secret must NEVER be exposed to the browser.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_secret_here"

# Optional webhook secret for Razorpay webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=""

# Resend — https://resend.com (transactional order emails)
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Sender address. Use your verified domain once set (e.g. "ArtBlush <orders@artblush.in>").
# Until then Resend's sandbox address is used and only verified recipients receive mail.
RESEND_FROM_EMAIL="ArtBlush <onboarding@resend.dev>"

# Optional: the studio's own email gets a notification on every paid order.
ARTBLUSH_STUDIO_NOTIFY_EMAIL=""

# Admin access — comma-separated emails granted the /admin dashboard
# (no DB change needed; e.g. "you@gmail.com")
ADMIN_EMAILS=""